    // Maximum number of results shown in the panel
    "max_results": 50,
    // Delay before searching while typing, in seconds
    "debounce": 0.5,
    // Minimum number of characters before searching
    "min_query_length": 3,
    // Skip files larger than this (ripgrep --max-filesize)
    "max_filesize": "100M",
    // Extra arguments passed to ripgrep
    "rg_args": [],
    // Print the executed commands in the console
    "debug": false,
}
